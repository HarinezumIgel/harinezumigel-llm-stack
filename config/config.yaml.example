
config_metadata:
  repository_license: "MIT"
  third_party_model_notice: >
    This configuration references third-party models.
    Model licenses, usage rights, and restrictions are determined by
    the upstream model publishers. Consult the 'upstream' URL for the
    current license and terms applicable to each model.

litellm_settings:
  drop_params: true
  set_verbose: false
  keep_alive: 15
  debug: false
  detailed_debug: false
  request_timeout: 240
  json_logs: true
  turn_off_message_logging: true
  redact_user_api_key_info: true

model_groups:
  rag:
    - mistral
    - guard
    - judge
    - bge-m3
    - bge-reranker-v2-m3
    - litellm
  rag_old:
    - mistral
    - guard
    - judge
    - mmarco-reranker
    - snowflake-embedder
    - litellm
  quick:
    - mistral
    - guard


model_list:
  # IMPORTANT:
  # - `rebuild` is a top-level key under each model entry.
  # - `--recreate` is allowed only when `rebuild: true` is explicitly set.
  # - If `rebuild` is missing or not true, recreate is blocked for that model.
  # - Sampling defaults belong in model_info.override_generation_config.
  # - Explicit request sampling parameters override these backend defaults.
  # - Pooling models are auto-detected by the configured vLLM image.
  # - model_info.mode groups startup summaries and log hints only in the launcher.
  # - Missing mode (or chat) displays as Inference; embedding/rerank stay separate.
  # - max_output_tokens: 1 is launcher metadata only for pooling models.
  # - Each RAG group budgets 0.71 for chat models + 0.08 + 0.08 = 0.87.
  # ---------------------------------------------------------------------------
  # RAG embeddings and reranking
  # Provider model names match --served-model-name, not local directory names.
  # ---------------------------------------------------------------------------
  - model_name: bge-m3
    litellm_params:
      model: hosted_vllm/bge-m3
      api_base: os.environ/BGE_M3_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: embedding
      alias: bge-m3-embedder
      model_dir: bge-m3
      context_length: 8192
      max_input_tokens: 8191
      max_output_tokens: 1
      gpu_memory_utilization: 0.08
      enforce_eager: true
      ipc: host
      dtype: auto
      max_num_seqs: 4
      max_num_batched_tokens: 8192
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "BGE M3 multilingual dense embeddings for RAG."
      upstream: "https://huggingface.co/BAAI/bge-m3"
      license: "See upstream model license"

  - model_name: bge-reranker-v2-m3
    litellm_params:
      model: hosted_vllm/bge-reranker-v2-m3
      api_base: os.environ/BGE_RERANKER_V2_M3_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: rerank
      alias: bge-reranker
      model_dir: bge-reranker-v2-m3
      context_length: 8192
      max_input_tokens: 8191
      max_output_tokens: 1
      gpu_memory_utilization: 0.08
      enforce_eager: true
      ipc: host
      dtype: auto
      max_num_seqs: 4
      max_num_batched_tokens: 8192
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "BGE reranker v2 M3 multilingual cross-encoder for RAG."
      upstream: "https://huggingface.co/BAAI/bge-reranker-v2-m3"
      license: "See upstream model license"

  - model_name: Snowflake/snowflake-arctic-embed-l-v2.0
    litellm_params:
      model: hosted_vllm/Snowflake/snowflake-arctic-embed-l-v2.0
      api_base: os.environ/SNOWFLAKE_ARCTIC_EMBED_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: embedding
      alias: snowflake-embedder
      model_dir: snowflake-arctic-embed-l-v2.0
      context_length: 8192
      max_input_tokens: 8191
      max_output_tokens: 1
      gpu_memory_utilization: 0.08
      enforce_eager: true
      ipc: host
      dtype: auto
      max_num_seqs: 4
      max_num_batched_tokens: 8192
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Legacy Snowflake Arctic multilingual embeddings for RAG."
      upstream: "https://huggingface.co/Snowflake/snowflake-arctic-embed-l-v2.0"
      license: "See upstream model license"

  - model_name: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
    litellm_params:
      model: hosted_vllm/cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
      api_base: os.environ/MMARCO_MINILM_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: rerank
      alias: mmarco-reranker
      model_dir: mmarco-mMiniLMv2-L12-H384-v1
      context_length: 512
      max_input_tokens: 511
      max_output_tokens: 1
      gpu_memory_utilization: 0.08
      enforce_eager: true
      ipc: host
      dtype: auto
      max_num_seqs: 4
      max_num_batched_tokens: 2048
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Legacy mMARCO multilingual MiniLM cross-encoder for RAG."
      upstream: "https://huggingface.co/cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"
      license: "See upstream model license"

  # ---------------------------------------------------------------------------
  # Safety / moderation
  # ---------------------------------------------------------------------------
  - model_name: llama_guard3_8b
    litellm_params:
      litellm_provider: openai
      model: openai/llama_guard3_8b
      api_base: os.environ/LLAMA_GUARD3_8B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 14400
    rebuild: true
    model_info:
      mode: inference
      model_dir: llama-guard3-8b
      generation_config: vllm
      override_generation_config:
        temperature: 0.0
        top_p: 1.0
      context_length: 1024
      max_input_tokens: 768
      max_output_tokens: 64
      max_tokens: 64
      # Shared Spark budget: guard 0.16 + mistral 0.27 + judge 0.28 = 0.71.
      gpu_memory_utilization: 0.16
      enforce_eager: true
      ipc: host
      dtype: auto
      max_num_seqs: 1
      max_num_batched_tokens: 512
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Safety/moderation only. Not for chat."
      detail: "Llama Guard 3 8B safety/moderation model for content filtering and safety checks"
      alias: "guard"
      license: "See upstream model license"
      upstream: "https://huggingface.co/meta-llama/Llama-Guard-3-8B"

  # ---------------------------------------------------------------------------
  # Fast general-purpose model
  # ---------------------------------------------------------------------------
  - model_name: llama_3_1_8b
    litellm_params:
      litellm_provider: openai
      model: openai/llama_3_1_8b
      api_base: os.environ/LLAMA_3_1_8B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 90
    rebuild: true
    model_info:
      mode: inference
      model_dir: llama3.1-8b
      generation_config: vllm
      override_generation_config:
        temperature: 0.7
        top_p: 0.9
      context_length: 24576
      max_input_tokens: 20480
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.45
      ipc: host
      dtype: auto
      max_num_seqs: 8
      max_num_batched_tokens: 16384
      enable_prefix_caching: true
      compilation_config:
        mode: VLLM_COMPILE
      structured_outputs_config:
        backend: xgrammar
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Lightweight chat, quick questions, scripts, low-latency tasks."
      detail: "Llama 3.1 8B fast general-purpose model with 24K context for quick responses"
      alias: "llama"
      license: "See upstream model license"
      upstream: "https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct"

  # ---------------------------------------------------------------------------
  # Fast lightweight fallback
  # ---------------------------------------------------------------------------
  - model_name: mistral_7b
    litellm_params:
      litellm_provider: openai
      model: openai/mistral_7b
      api_base: os.environ/MISTRAL_7B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 90
    rebuild: true
    model_info:
      mode: inference
      model_dir: mistral-7b-instruct-v0.3
      generation_config: vllm
      override_generation_config:
        temperature: 0.7
        top_p: 0.9
      context_length: 32768
      max_input_tokens: 28000
      max_output_tokens: 2048
      max_tokens: 2048
      gpu_memory_utilization: 0.27
      enforce_eager: false
      ipc: host
      dtype: auto
      max_num_seqs: 1
      max_num_batched_tokens: 4096
      speculative_config: null
      enable_prefix_caching: true
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Fast general assistant, summaries, command-line help."
      detail: "Mistral 7B v0.3 fast lightweight fallback model with 32K context"
      alias: "mistral"
      license: "See upstream model license"
      upstream: "https://huggingface.co/mistralai/Mistral-7B-Instruct-v0.3"

  # ---------------------------------------------------------------------------
  # Qwen2.5 32B AWQ
  # ---------------------------------------------------------------------------
  - model_name: qwen2_5_32b_awq
    litellm_params:
      litellm_provider: openai
      model: openai/qwen2_5_32b_awq
      api_base: os.environ/QWEN2_5_32B_AWQ_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 180
    rebuild: true
    model_info:
      mode: inference
      model_dir: qwen2.5-32b-awq
      context_length: 32768
      max_input_tokens: 28672
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.90
      ipc: host
      dtype: auto
      max_num_seqs: 1
      max_num_batched_tokens: 16384
      quantization: null
      kv_cache_dtype: auto
      enable_prefix_caching: true
      attention_backend: flashinfer
      generation_config: vllm
      override_generation_config:
        temperature: 0.3
        top_p: 0.9
        top_k: 20
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Strong general-purpose model, good reasoning, decent coding."
      detail: "Qwen2.5 32B AWQ 4-bit quantized model with 32K context and strong reasoning capabilities"
      alias: "qwen32"
      license: "See upstream model license"
      upstream: "https://huggingface.co/Qwen/Qwen2.5-32B-Instruct-AWQ"

  # ---------------------------------------------------------------------------
  # Qwen3-Coder-Next AWQ: BIG CONTEXT profile
  # ---------------------------------------------------------------------------
  - model_name: Qwen3-Coder-Next-AWQ
    litellm_params:
      litellm_provider: openai
      model: openai/Qwen3-Coder-Next-AWQ
      api_base: os.environ/QWEN3_CODER_3_NEXT_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: inference
      model_dir: Qwen3-Coder-Next-AWQ
      context_length: 262144
      max_input_tokens: 250000
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.90
      ipc: host
      dtype: auto
      max_num_seqs: 1
      max_num_batched_tokens: 8192
      quantization: compressed-tensors
      kv_cache_dtype: fp8
      enforce_eager: false
      enable_prefix_caching: true
      attention_backend: flashinfer
      generation_config: vllm
      override_generation_config:
        temperature: 0.2
        top_p: 0.9
        top_k: 20
      enable_auto_tool_choice: true
      tool_call_parser: qwen3_coder
      reasoning_parser: qwen3
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Agentic coding, repo navigation, tool-based coding workflows."
      detail: "Qwen3-Coder-Next AWQ with 262K context, FP8 cache, and tool calling support for agentic workflows"
      alias: "coder"
      license: "See upstream model license"
      upstream: "https://huggingface.co/Qwen/Qwen3-Coder-Next"

  # ---------------------------------------------------------------------------
  # qwen3.6-27b Standard coding / chat model
  # ---------------------------------------------------------------------------
  - model_name: qwen3.6-27b
    litellm_params:
      litellm_provider: openai
      model: openai/qwen3.6-27b
      api_base: os.environ/QWEN_3_6_27B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 240
    rebuild: true
    model_info:
      mode: inference
      model_dir: Qwen3.6-27B
      context_length: 65536
      max_input_tokens: 60000
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.94
      ipc: host
      dtype: auto
      max_num_seqs: 8
      max_num_batched_tokens: 32768
      quantization: null
      kv_cache_dtype: fp8
      enforce_eager: false
      enable_prefix_caching: true
      attention_backend: flashinfer
      generation_config: vllm
      override_generation_config:
        temperature: 0.3
        top_p: 0.9
        top_k: 20
      enable_auto_tool_choice: true
      tool_call_parser: qwen3_coder
      reasoning_parser: qwen3
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Daily assistant/chat model. Probably your best conversational model."
      detail: "Qwen3.6 27B balanced coding/chat model with 65K context, FP8 cache, and tool calling"
      alias: "chat"
      license: "See upstream model license"
      upstream: "https://huggingface.co/Qwen/Qwen3.6-27B"

  # ---------------------------------------------------------------------------
  # DeepSeek-Coder 6.7B RAG / fast tasks
  # ---------------------------------------------------------------------------
  - model_name: deepseek-coder-6.7b-instruct
    litellm_params:
      litellm_provider: openai
      model: openai/deepseek-coder-6.7b-instruct
      api_base: os.environ/DEEPSEEK_CODER_6_7B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 120
    rebuild: true
    model_info:
      mode: inference
      model_dir: deepseek-coder-6.7b-instruct
      context_length: 32768
      max_input_tokens: 28000
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.50
      ipc: host
      dtype: auto
      max_num_seqs: 8
      max_num_batched_tokens: 16384
      enforce_eager: false
      enable_prefix_caching: true
      attention_backend: flashinfer
      generation_config: vllm
      override_generation_config:
        temperature: 0.2
        top_p: 0.9
        top_k: 20
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Autocomplete, small edits, code snippets, low latency."
      detail: "DeepSeek-Coder 6.7B fast coding model with 32K context for quick code operations"
      alias: "fast-coder"
      license: "See upstream model license"
      upstream: "https://huggingface.co/deepseek-ai/deepseek-coder-6.7b-instruct"

# ---------------------------------------------------------------------------
# Qwen2.5-1.5B-Instruct
# Small Judge / Evaluation Model
# ---------------------------------------------------------------------------
  - model_name: qwen2_5_1_5b_instruct
    litellm_params:
      litellm_provider: openai
      model: openai/qwen2_5_1_5b_instruct
      api_base: os.environ/QWEN2_5_1_5B_INSTRUCT_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 120

    rebuild: true

    model_info:
      mode: inference
      model_dir: Qwen2.5-1.5B-Instruct

      context_length: 8192
      max_input_tokens: 6144
      max_output_tokens: 2048
      max_tokens: 1024

      # Spark: about 7.3 GiB, including 2.88 GiB BF16 weights and 224 MiB KV at 8K.
      gpu_memory_utilization: 0.06
      enforce_eager: true
      generation_config: vllm
      override_generation_config:
        temperature: 0.0
        top_p: 1.0

      ipc: host
      dtype: auto

      max_num_seqs: 1
      max_num_batched_tokens: 2048

      quantization: null
      kv_cache_dtype: auto

      speculative_config: null

      enable_prefix_caching: true

      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0

      description: "Small evaluator/judge model for RAG answer assessment."

      detail: "Qwen2.5-1.5B-Instruct configured for groundedness, completeness, and hallucination evaluation."

      alias: "judge_small"

      license: "Apache 2.0"
      upstream: "Qwen"


# ---------------------------------------------------------------------------
# Qwen2.5-14B-Instruct
# Judge / Evaluation Model
# ---------------------------------------------------------------------------
  - model_name: qwen2_5_14b_instruct

    litellm_params:
      litellm_provider: openai
      model: openai/qwen2_5_14b_instruct
      api_base: os.environ/QWEN2_5_14B_INSTRUCT_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 180

    rebuild: true

    model_info:
      mode: inference
      model_dir: Qwen2.5-14B-Instruct
      generation_config: vllm
      override_generation_config:
        temperature: 0.0
        top_p: 1.0

      # Native model context is larger, but for judging this is usually enough.
      context_length: 8192
      max_input_tokens: 6144
      max_output_tokens: 2048
      max_tokens: 1024

      # Shares the Spark with mistral and guard; leave memory for the OS.
      gpu_memory_utilization: 0.28
      enforce_eager: true

      ipc: host

      dtype: auto

      # Single evaluation request at a time
      max_num_seqs: 1

      # No need for large batching on a judge
      max_num_batched_tokens: 2048

      quantization: null

      kv_cache_dtype: auto

      # Keep it simple first
      speculative_config: null

      enable_prefix_caching: true

      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0

      input_cost_per_token: 0
      output_cost_per_token: 0

      description: "Dedicated RAG evaluation and grounding judge."

      detail: >
        Qwen2.5-14B-Instruct configured for deterministic
        assessment of groundedness, hallucinations,
        contradictions, completeness, and answer quality.

      alias: "judge"

      license: "Apache-2.0"

      upstream: "Qwen"

  # ---------------------------------------------------------------------------
  # Qwen3.5-122B-A10B-int4-AutoRound
  # ---------------------------------------------------------------------------

  - model_name: qwen3.5

    litellm_params:
      litellm_provider: openai
      model: openai/qwen3.5
      api_base: os.environ/QWEN3_5_122B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 300
    rebuild: true

    model_info:
      mode: inference
      model_dir: Qwen3.5-122B-A10B-int4-AutoRound

      context_length: 196608
      max_input_tokens: 192512
      max_output_tokens: 4096
      max_tokens: 4096
      gpu_memory_utilization: 0.82
      ipc: host
      dtype: bfloat16
      max_num_batched_tokens: 32768
      max_num_seqs: 8
      load_format: instanttensor
      enable_chunked_prefill: true
      attention_backend: FLASHINFER
      generation_config: vllm
      override_generation_config:
        temperature: 0.2
        top_p: 0.95
        top_k: -1
        presence_penalty: 0.0
        repetition_penalty: 1.0
      enable_auto_tool_choice: true
      tool_call_parser: qwen3_coder
      reasoning_parser: qwen3
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Large-context assistant, research, broad knowledge, but quantization may hurt coding."
      detail: "Intel Qwen3.5 122B A10B INT4 AutoRound with 196K context for research and broad knowledge tasks"
      alias: "qwen35"
      license: "Apache-2.0"
      upstream: "https://huggingface.co/Intel/Qwen3.5-122B-A10B-int4-AutoRound"

  # ---------------------------------------------------------------------------
  # Qwen3.8: standalone Spark, BF16 weights/cache, native MTP decoding
  # ---------------------------------------------------------------------------
  - model_name: qwen3.8-27B
    litellm_params:
      litellm_provider: openai
      model: openai/qwen3.8-27B
      api_base: os.environ/QWEN3_8_27B_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 300
    rebuild: true
    model_info:
      mode: inference
      model_dir: Qwen3.8-27B
      generation_config: vllm
      override_generation_config:
        temperature: 0.2
        top_p: 0.95
      context_length: 253952
      max_input_tokens: 233472
      max_output_tokens: 16384
      max_tokens: 16384
      gpu_memory_utilization: 0.90
      ipc: host
      dtype: auto
      # One active coding request; keep graphs and native-precision KV cache.
      max_num_seqs: 1
      max_num_batched_tokens: 16384
      enable_chunked_prefill: true
      enforce_eager: false
      quantization: null
      kv_cache_dtype: auto
      speculative_config:
        method: mtp
        num_speculative_tokens: 3
      enable_prefix_caching: true
      enable_auto_tool_choice: true
      tool_call_parser: qwen3_coder
      reasoning_parser: qwen3
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0
      input_cost_per_token: 0
      output_cost_per_token: 0
      description: "Large-context reasoning/coding assistant with tool calling."
      detail: "Qwen3.8 BF16 with 253952-token context, native-precision KV cache, and native MTP speculative decoding"
      alias: "qwen3.8"
      license: "See upstream model license"
      upstream: "See upstream model publisher"

  # ---------------------------------------------------------------------------
  # Qwen3-Coder-30B-A3B-Instruct: standalone Spark, BF16, DFlash decoding
  # ---------------------------------------------------------------------------
  - model_name: qwen3-coder-30b-a3b-instruct
    litellm_params:
      litellm_provider: openai
      model: openai/qwen3-coder-30b-a3b-instruct
      api_base: os.environ/QWEN3_CODER_30B_A3B_INSTRUCT_API_BASE
      api_key: os.environ/LOCAL_VLLM_API_KEY
      request_timeout: 300
    rebuild: true
    model_info:
      mode: inference
      model_dir: Qwen3-Coder-30B-A3B-Instruct
      generation_config: vllm
      override_generation_config:
        temperature: 0.2
        top_p: 0.95
      context_length: 253952
      max_input_tokens: 233472
      max_output_tokens: 16384
      max_tokens: 16384
      gpu_memory_utilization: 0.90
      ipc: host
      dtype: auto
      # One active coding request; keep graphs and native-precision KV cache.
      max_num_seqs: 1
      max_num_batched_tokens: 16384
      enable_chunked_prefill: true
