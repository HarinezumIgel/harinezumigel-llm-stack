# ---------------------------------------------------------------------------
# Terminal colors (standard names, bright-NAME, or default)
# NO_COLOR disables all styling. Headings retain bold styling.
# ---------------------------------------------------------------------------
HLS_SUCCESS_COLOR=green
HLS_FAILURE_COLOR=red
HLS_WARNING_COLOR=yellow
HLS_ACCENT_COLOR=cyan
HLS_HEADING_COLOR=default

# ---------------------------------------------------------------------------
# Core paths
# ---------------------------------------------------------------------------
MODEL_ROOT=/opt/models

LITELLM_VENV_ACTIVATE=/opt/litellm/venv/bin/activate
LITELLM_BIN=/opt/litellm/venv/bin/litellm

# ---------------------------------------------------------------------------
# LiteLLM proxy bind
# Clients (for example Copilot) connect to http://192.168.100.50:4000/v1.
# Replace 192.168.100.50 with an IP assigned to YOUR target host.
# LITELLM_BIND_HOST controls where LiteLLM listens; LITELLM_HOST is not used.
# 127.0.0.1 permits host-local clients only; 0.0.0.0 listens on all IPv4
# interfaces. A specific LAN IP permits LAN access without a wildcard bind.
# Restrict access with firewall rules and set a strong LITELLM_MASTER_KEY.
# ---------------------------------------------------------------------------
LITELLM_BIND_HOST=192.168.100.50
LITELLM_PORT=4000

# Runtime logs are written to /opt/litellm/logs/litellm_YYYYMMDD_HHMMSS.log

# ---------------------------------------------------------------------------
# Private vLLM backends: LiteLLM and Docker run on the SAME target host.
# VLLM_HOST builds the *_API_BASE URLs that LiteLLM connects to.
# VLLM_BIND_HOST selects the host interface where Docker publishes backend ports.
# Keep BOTH at 127.0.0.1 for this setup, even when clients use a LAN IP for
# LiteLLM. Clients do not need direct access to the vLLM backend ports.
# Do NOT pair a LAN VLLM_HOST with a loopback VLLM_BIND_HOST: connection refused.
# Changing VLLM_HOST requires restarting LiteLLM; changing VLLM_BIND_HOST
# requires recreating the affected backend containers.
# ---------------------------------------------------------------------------
VLLM_HOST=127.0.0.1
VLLM_BIND_HOST=127.0.0.1
VLLM_CONTAINER_PORT=8000

# ---------------------------------------------------------------------------
# Docker runtime image and mounts
# ---------------------------------------------------------------------------
# IMPORTANT: Choose an image tag compatible with your host NVIDIA driver.
# Check host driver version with: nvidia-smi
# Example guidance:
#   - Driver 595.x -> nvcr.io/nvidia/vllm:26.05.post1-py3
#   - Driver 580.x -> nvcr.io/nvidia/vllm:25.11-py3
# A mismatch can fail at container startup with driver compatibility errors.
VLLM_DOCKER_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
VLLM_MODEL_VOLUME=/opt/models:/models
VLLM_CACHE_VOLUME=/opt/vllm-cache:/root/.cache/huggingface

# ---------------------------------------------------------------------------
# LiteLLM proxy key
# Client -> LiteLLM uses this.
# ---------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-change-me

# ---------------------------------------------------------------------------
# Shared backend key
# LiteLLM -> vLLM containers use this.
# vLLM containers must be started with this same value as --api-key.
# ---------------------------------------------------------------------------
LOCAL_VLLM_API_KEY=sk-change-me

# ---------------------------------------------------------------------------
# Backend ports
# ---------------------------------------------------------------------------
MISTRAL_7B_PORT=8001
LLAMA_3_1_8B_PORT=8002
LLAMA_GUARD3_8B_PORT=8003
QWEN2_5_32B_AWQ_PORT=8004
QWEN_CODER_3_NEXT_PORT=8005
QWEN_3_6_27B_PORT=8006
DEEPSEEK_CODER_6_7B_PORT=8007
QWEN3_5_122B_PORT=8009
QWEN3_8_27B_PORT=8010
QWEN3_CODER_30B_A3B_INSTRUCT_PORT=8011
QWEN2_5_1_5B_INSTRUCT_PORT=8012
QWEN2_5_14B_INSTRUCT_PORT=8013

# ---------------------------------------------------------------------------
# Full API bases
# LiteLLM reads these as whole env vars from config.yaml.
# ---------------------------------------------------------------------------
MISTRAL_7B_API_BASE=http://${VLLM_HOST}:${MISTRAL_7B_PORT}/v1
LLAMA_3_1_8B_API_BASE=http://${VLLM_HOST}:${LLAMA_3_1_8B_PORT}/v1
LLAMA_GUARD3_8B_API_BASE=http://${VLLM_HOST}:${LLAMA_GUARD3_8B_PORT}/v1
QWEN2_5_32B_AWQ_API_BASE=http://${VLLM_HOST}:${QWEN2_5_32B_AWQ_PORT}/v1
QWEN3_CODER_3_NEXT_API_BASE=http://${VLLM_HOST}:${QWEN_CODER_3_NEXT_PORT}/v1
QWEN_3_6_27B_API_BASE=http://${VLLM_HOST}:${QWEN_3_6_27B_PORT}/v1
DEEPSEEK_CODER_6_7B_API_BASE=http://${VLLM_HOST}:${DEEPSEEK_CODER_6_7B_PORT}/v1
QWEN3_5_122B_API_BASE=http://${VLLM_HOST}:${QWEN3_5_122B_PORT}/v1
QWEN3_8_27B_API_BASE=http://${VLLM_HOST}:${QWEN3_8_27B_PORT}/v1
QWEN3_CODER_30B_A3B_INSTRUCT_API_BASE=http://${VLLM_HOST}:${QWEN3_CODER_30B_A3B_INSTRUCT_PORT}/v1
QWEN2_5_1_5B_INSTRUCT_API_BASE=http://${VLLM_HOST}:${QWEN2_5_1_5B_INSTRUCT_PORT}/v1
QWEN2_5_14B_INSTRUCT_API_BASE=http://${VLLM_HOST}:${QWEN2_5_14B_INSTRUCT_PORT}/v1
